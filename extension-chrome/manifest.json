{
  "manifest_version": 3,
  "name": "browserskill bridge",
  "version": "1.1.0",
  "description": "Полный доступ к Chrome для агентов через native messaging (без HTTP).",
  "minimum_chrome_version": "120",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "browserskill",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["console-hook-main.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["console-hook.js"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "nativeMessaging",
    "tabs",
    "activeTab",
    "scripting",
    "userScripts",
    "webNavigation",
    "webRequest",
    "cookies",
    "history",
    "bookmarks",
    "downloads",
    "downloads.open",
    "storage",
    "unlimitedStorage",
    "sessions",
    "browsingData",
    "management",
    "clipboardRead",
    "clipboardWrite",
    "notifications",
    "privacy",
    "proxy",
    "topSites",
    "pageCapture",
    "idle",
    "alarms",
    "search",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"]
}
